# Copy to .env.local and fill in your keys. .env.local is gitignored.

# Anthropic — used to generate taglines and assignment lines.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — "Nano Banana" (gemini-2.5-flash-image) for card art.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults live in deck/globals.json; these win if set).
# TEXT_MODEL=claude-opus-5
# IMAGE_MODEL=gemini-2.5-flash-image
