	"lines": [
		{
			"from": 0.42,
			"to": 3.311,
			"text": "For as long as anyone can remember, someone has been watching the vibes."
		},
		{
			"from": 3.261,
			"to": 4.595,
			"text": "That someone is us."
		},
		{
			"from": 4.655,
			"to": 6.661,
			"text": "At VibeCorp\u2019s Department of Vibe Assessment,"
		},
		{
			"from": 6.611,
			"to": 9.589,
			"text": "our officers monitor the universe\u2019s frequencies \u2014 so you don\u2019t have to."
		},
		{
			"from": 9.539,
			"to": 12.943,
			"text": "Every day, thousands of assessments. Calibrations. Readings."
		},
		{
			"from": 12.893,
			"to": 14.649,
			"text": "The work is vital. The work is endless."
		},
		{
			"from": 14.599,
			"to": 16.6,
			"text": "And we are always looking for more."
		},
		{
			"from": 16.55,
			"to": 19.542,
			"text": "Individuals of rare frequency. People with good vibes."
		},
		{
			"from": 19.922,
			"to": 23.528,
			"text": "Requirements are simple: a steady pulse, a discerning eye, and no fear of the hum."
		},
		{
			"from": 23.478,
			"to": 25.806,
			"text": "If your frequency is true \u2014 we will find you."
		},
		{
			"from": 25.756,
			"to": 28.525,
			"text": "VibeCorp. Your frequency has already been logged."
		}
	],
