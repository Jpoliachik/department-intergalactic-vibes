{
  "name": "vibe-corp-film",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe Corp recruitment film \u2014 A Higher Frequency (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "music": "python3 scripts/music.py",
    "sfx": "python3 scripts/sfx.py",
    "voice": "node scripts/voice.mjs",
    "render": "remotion render src/index.ts HigherFrequency out/a-higher-frequency.mp4 --crf=18",
    "render:vertical": "remotion render src/index.ts HigherFrequencyVertical out/a-higher-frequency-9x16.mp4 --crf=18",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fontsource/cormorant": "5.1.1",
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/oswald": "5.1.1",
    "@remotion/cli": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
