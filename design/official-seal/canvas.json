  "annotations": [
    {
      "id": "why",
      "x": 2320,
      "y": 0,
      "w": 300,
      "page": "page-1",
      "text": "Balance pass on the two constructions with star shoulders.\n\nOne measure was wrong: the type band was 9.7 units deep against a 79-unit centre. A ring that thin next to a centre that big reads as a caption around a logo, not as half of one mark.\n\nType 13.5 to 17, stars 10.8 to 16, waves 84 to 80 \u2014 and the rules move in too, since growing type without moving the rules just crowds it."
    },
    {
      "id": "history",
      "x": 3700,
      "y": 0,
      "w": 280,
      "page": "page-2",
      "text": "Everything earlier, kept for the record. The beaded stamp on page one came out of these."
    }
  ],
